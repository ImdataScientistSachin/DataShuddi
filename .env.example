# Environment Configuration — DataShuddi
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── PostgreSQL (LangGraph PostgresSaver Checkpointer) ───────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datashuddi
POSTGRES_USER=datashuddi_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_URL=postgresql://datashuddi_user:your_secure_password_here@localhost:5432/datashuddi

# ─── Qdrant Vector Database ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=datashuddi_docs
# Uncomment if using Qdrant Cloud:
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ─── Ollama (Local LLM Server) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PII_MODEL=qwen2.5-coder:3b
OLLAMA_REFLECTOR_MODEL=qwen2.5-coder:14b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ─── LangSmith Observability (Optional — traces will be scrubbed of PII) ─────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=datashuddi-local

# ─── DataShuddi Pipeline Configuration ───────────────────────────────────────
# OCR fallback threshold: pages with < this many chars/page trigger PaddleOCR
OCR_CHAR_DENSITY_THRESHOLD=50
# PaddleOCR minimum confidence to keep a line (0.0 - 1.0)
PADDLEOCR_MIN_CONFIDENCE=0.70
# Default header/footer detection threshold (fraction of pages a line must appear on)
HF_THRESHOLD_DEFAULT=0.30
# Maximum retry attempts before routing to human review queue
MAX_RETRY_COUNT=3
# PII count threshold to escalate to human review
PII_ESCALATION_THRESHOLD=50
# Reflector confidence gate (minimum confidence to write to Store)
REFLECTOR_CONFIDENCE_GATE=0.70
# Max threshold delta cap per Reflector iteration
REFLECTOR_MAX_DELTA=0.05

# ─── Data Paths ──────────────────────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
HUMAN_REVIEW_DIR=./data/human_review
TEST_FIXTURES_DIR=./tests/fixtures
QDRANT_STORAGE_DIR=./data/qdrant_storage
POSTGRES_DATA_DIR=./data/postgres_data

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to true to enable scrubbed LangSmith tracing
ENABLE_LANGSMITH_TRACING=false
